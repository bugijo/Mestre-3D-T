# =============================================================================
# Dungeon Keeper V1 — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# The server reads these variables at startup via process.env.
# Client-side Vite variables must be prefixed with VITE_.

# =============================================================================
# MODE SELECTION
# =============================================================================
# Set to "lan" (default) for local network sessions, or "online" for public/cloud.
APP_MODE=lan

# =============================================================================
# LAN MODE SETTINGS (APP_MODE=lan)
# =============================================================================
LAN_HOST=0.0.0.0
LAN_PORT=4173

# =============================================================================
# ONLINE MODE SETTINGS (APP_MODE=online)
# =============================================================================
# APP_MODE=online
# PORT=10000
# PUBLIC_APP_URL=https://rpg-alpha.onrender.com
# ALLOWED_ORIGINS=https://rpg-alpha.onrender.com
# NODE_ENV=production

# =============================================================================
# SUPABASE — Server-side (service role, for ONLINE persistence)
# =============================================================================
# SUPABASE_URL=https://mlhrloxhbrscvcclcxxh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_S11HOH-gqLturTdbm6Ujrg_a_oKTzlW

# =============================================================================
# SUPABASE — Client-side (Vite, must be prefixed with VITE_)
# =============================================================================
# VITE_SUPABASE_URL=https://mlhrloxhbrscvcclcxxh.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

# =============================================================================
# WEBSOCKET — Client-side override (optional)
# =============================================================================
# Override the WebSocket URL detected from window.location.
# Supports both VITE_WS_URL (new) and VITE_LAN_WS_URL (legacy).
# VITE_WS_URL=wss://rpg-alpha.onrender.com/ws